{
  "compilerOptions": {
    "lib": ["es2020"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2020",
    "declaration": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"]
}
